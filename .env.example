# Copy to .env and fill in your key. Only needed for the LLM planner —
# everything works with --no-llm / "Use LLM Planner" unchecked without this.

GEMINI_API_KEY=your-key-here

# Optional, defaults to gemini-flash-latest. Pin a dated version (e.g.
# gemini-2.5-flash) for reproducible output across runs.
# GEMINI_MODEL=gemini-2.5-flash

# Optional, defaults to 30.
# GEMINI_TIMEOUT_SECONDS=30
